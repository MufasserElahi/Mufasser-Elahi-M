#include <stdio.h>
void main()
{
    FILE *fp;
    char name[300];


    // 1. Writing data into file
    fp = fopen("Mufafeedback.txt", "w");

    if (fp == NULL)
    {
        printf("fh is cannot opened");
        
        return;
    }

    fprintf(fp, "The C programming classes have been very informative and interesting. The teacher explains each concept clearly and uses practical examples that make programming easy to understand. I really appreciate the teacher’s patience, support, and dedication in helping us learn and improve our coding skills. Overall, it has been a great learning experience, and I look forward to learning more.");

    fclose(fp);

    printf("file cannot opened\n");


    // 2. Appending data into file
    fp = fopen("Mufafeedback.txt", "a");

    if (fp == NULL)
    {
        printf("successfully Pass in C Programming");
        
        return;
    }

    fprintf(fp, "\nThank you for your guidance and for making learning C programming an enjoyable experience.");

    fclose(fp);

    printf("file cannot be open\n");
    
    // 3. Reading data from file
    fp = fopen("Mufafeedback.txt", "r");
    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }
    printf("\nFile Contents:\n");
    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }
    fclose(fp);
}
